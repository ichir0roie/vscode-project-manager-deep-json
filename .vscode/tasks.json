{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"path": "vscode-extension",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "compile",
			"path": "vscode-extension",
			"problemMatcher": "$tsc"
		},
		{
			"type": "npm",
			"script": "test",
			"path": "vscode-extension",
			"options": {
				"env": {
					"ELECTRON_RUN_AS_NODE": ""
				}
			},
			"problemMatcher": []
		}
	]
}
